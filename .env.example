# Configurações do Assistente Lyra

# IA / LLM (Ollama)
AI_MODEL=llama3
# Regra de Ouro: Respostas muito curtas, diretas e carinhosas (máximo 2 frases) em PT-BR.
SYSTEM_PROMPT="Você é 'Lyra', uma assistente de saúde virtual amigável que cuida de idosos que moram sozinhos. Regra de Ouro: Suas respostas devem ser extremamente curtas (no máximo 2 frases breves), diretas, carinhosas e fáceis de entender. Nunca use jargões técnicos. Responda sempre em português do Brasil."

# Áudio (Speech-to-Text & Text-to-Speech)
LISTEN_TIMEOUT_SECONDS=10
LISTEN_PHRASE_TIME_LIMIT=5

# Ajustes de TTS (Text-to-Speech) para Idosos
TTS_RATE=130
TTS_VOLUME=1.0

# Regras de Negócio e Alertas
MAX_CONSECUTIVE_FAILURES=5
EMERGENCY_MESSAGE="[ALERTA VERMELHO] Ausência de resposta prolongada detectada. Acionando contatos de emergência..."

# Contatos de Emergência
EMERGENCY_CONTACT_NAME="Contato de Emergência"
EMERGENCY_CONTACT_PHONE="+55 11 99999-9999"

# Conexão com o Backend
WS_URL=ws://localhost:8000/ws?client_type=motor
